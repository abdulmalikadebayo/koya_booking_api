# Copy to .env.local for local development.
# For production builds, VITE_API_URL comes from .env.production and VITE_API_KEY
# is set in the hosting dashboard (Netlify > Environment variables).

# API base URL
VITE_API_URL=http://localhost:8001

# The key this page sends in X-API-Key. It ends up in the page's JavaScript, so use a
# key separate from the one you submit to Koya.
VITE_API_KEY=
